# Tracking — set these in Vercel → Project → Settings → Environment Variables.
# Any that are blank are simply skipped. Nothing loads until a visitor accepts the cookie banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=        # Google Analytics 4, looks like G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=            # Meta Pixel; defaults to 1769334424374974 (openflowai.io) when unset
NEXT_PUBLIC_APOLLO_APP_ID=            # Apollo website-visitor tracker (defaults to the current app id)

# Where the /referral sign-up form posts. Defaults to the same n8n webhook the demo form uses,
# with formType: "referral" in every payload.
NEXT_PUBLIC_REFERRAL_WEBHOOK_URL=
